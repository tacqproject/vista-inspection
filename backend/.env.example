# Copy to backend/.env and adjust for this machine.
DATABASE_URL=sqlite+aiosqlite:///./vista.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=2048

MESHROOM_PATH=meshroom_batch
GLTFPACK_PATH=gltfpack
# Use a disk with enough space for reconstruction scratch files.
WORK_DIR=./uploads/scratch
# External inference command; leave empty until the AI environment is installed.
DACL10K_CMD=
DEFAULT_QUALITY=max
AUTO_DEFECTS=true

JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_HOURS=12
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-before-first-start
