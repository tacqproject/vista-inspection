# RAW instance only; database/uploads/scratch must stay under this separate root.
ISOLATED_DATA_ROOT=./raw-data
DATABASE_URL=sqlite+aiosqlite:///./raw-data/vista.db
UPLOAD_DIR=./raw-data/uploads
WORK_DIR=./raw-data/scratch
RAW_SOURCE_ROOT=
CORS_ORIGINS=http://localhost:5174
MAX_UPLOAD_SIZE_MB=2048
DISK_RESERVE_GB=10
MESHROOM_PATH=meshroom_batch
GLTFPACK_PATH=gltfpack
DACL10K_CMD=
DEFAULT_QUALITY=max
AUTO_RECONSTRUCT=false
AUTO_DEFECTS=false
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_HOURS=12
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-before-first-start
